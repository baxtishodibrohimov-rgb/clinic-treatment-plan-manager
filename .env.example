# Copy to .env and fill in your own values. docker-compose reads this file
# for the backend/celery services (DATABASE_URL/REDIS_URL are overridden to
# point at the postgres/redis containers — see docker-compose.yml).

# Core
APP_ENV=development
APP_BASE_URL=http://localhost:3000
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database / broker (used directly when running the backend without Docker;
# docker-compose overrides these to point at its own containers)
DATABASE_URL=postgresql+psycopg://tp_user:tp_password@localhost:5432/tp_manager
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Telegram Bot API — create a bot with @BotFather to get a token.
# Leave unset and notifications simply queue up as "failed" with a clear
# reason instead of crashing anything.
TELEGRAM_BOT_TOKEN=

# Cliniccards — leave everything below unset to run entirely on the
# built-in mock adapter (5 fake patients with "2-konsultatsiya" appointments,
# zero configuration needed). Set the first two once real credentials + API
# docs are available; the *_PATH vars only need overriding if Cliniccards'
# REST paths differ from the guessed defaults in
# backend/app/integrations/cliniccards/http_provider.py.
CLINICCARDS_MODE=mock
CLINICCARDS_API_URL=https://cliniccards.com/api
CLINICCARDS_API_KEY=
CLINICCARDS_API_KEY_HEADER=Token
CLINICCARDS_PATIENTS_PATH=/patients
CLINICCARDS_APPOINTMENTS_PATH=/visits
CLINICCARDS_APPOINTMENT_BY_ID_PATH=/visits/{appointment_id}
CLINICCARDS_PATIENT_DOCUMENTS_PATH=/files/{patient_id}
CLINICCARDS_PATIENT_IMAGES_PATH=/files/{patient_id}
CLINICCARDS_FILE_PATH=/file
CLINICCARDS_SYNC_DAYS_BACK=1
CLINICCARDS_SYNC_DAYS_AHEAD=60

# Shared secret Cliniccards must send back on webhook calls
# (header x-cliniccards-signature). Leave unset only for local testing.
CLINICCARDS_WEBHOOK_SECRET=

# Frontend build-time var (see frontend/.env.local for local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000
